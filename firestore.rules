rules_version = '2';

// ===== REGRAS DO FIRESTORE - Barovia Wiki =====
// Cole estas regras no console do Firebase:
// Firestore Database > Regras (Rules) > Publicar.
//
// ATENCAO SOBRE SEGURANCA:
// O site nao tem login. Estas regras liberam leitura e escrita para
// qualquer pessoa que abrir o site. Isso e aceitavel para uma wiki
// privada compartilhada entre amigos, mas significa que qualquer um
// com o link pode editar/apagar dados.
//
// Recomendado: adicione a data-limite abaixo e va renovando, ou
// migre para Firebase Auth quando quiser controle real de acesso.

service cloud.firestore {
  match /databases/{database}/documents {

    // Coamente as colecoes usadas pelo app
    match /{collection}/{docId} {
      allow read, write: if request.time < timestamp.date(2027, 1, 1);
    }
  }
}
